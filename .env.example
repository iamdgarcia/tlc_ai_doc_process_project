# Luma Spend — Process Documents API
# Copia este archivo a .env y rellena los valores reales:
#   cp .env.example .env
# Cada variable corresponde a un campo de src/app/core/config.py.

APP_NAME=Process Documents API
# En production, MASTER_KEY es obligatorio y no puede ser "changeme" (la app no arranca).
ENVIRONMENT=development
MASTER_KEY=changeme

# LLM (extracción estructurada y agente de chat)
OPENAI_API_KEY=
# URL base alternativa (Novita, etc.); se sigue aceptando BASE_URL por compatibilidad
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CHAT_MODEL=google/gemma-4-31b-it
OCR_MODEL=deepseek/deepseek-ocr-2

# OCR externo (opcional; sin SCANEAME_API_KEY la extracción va directa al LLM)
SCANEAME_API_KEY=
SCANEAME_API_URL=https://scaneame.iamdgarcia.com/v1/process
SCANEAME_ENDPOINT=tickets
SCANEAME_REQUEST_TIMEOUT_SECONDS=60
SCANEAME_PROCESSING_TIMEOUT_SECONDS=90
SCANEAME_POLL_INTERVAL_SECONDS=1

# Base de datos (SQLite en desarrollo; PostgreSQL en producción)
DATABASE_URL=sqlite:///./receipts.db

# Observabilidad (opcional; las lee la librería langsmith directamente)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
